# ── PostgreSQL ────────────────────────────────
DB_HOST=encourage_db
DB_PORT=5432
DB_USER=bot_user
DB_PASSWORD=
# Schema-owner creds for `npm run db:rollout` migrations (needs CREATE privilege)
# — distinct from the app runtime user above
DB_ROLLOUT_USER=
DB_ROLLOUT_PASSWORD=
DB_NAME=project-encourage

# ── MSQL (Legacy) ────────────────────────────────
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# ── database-service (ds) ──────────────────────────────
# In-container listen port, read by DS app code
DS_PORT=3000
# Host-side port mapping only (root docker-compose.yml) — not read by app code
DS_SERVICE_PORT=3010
DS_URL=http://encourage_ds:3000
DS_PE_API_SECRET=
DS_MS_API_SECRET=
DS_POSTMAN_API_SECRET=

# ── project-moderator (ms) ────────────────────────────
MS_DISCORD_TOKEN=
MS_CLIENT_ID=
MS_PE_API_SECRET=
# In-container listen port, read by MS app code
MS_PORT=4001
# Host-side port mapping only (root docker-compose.yml) — not read by app code
MS_SERVICE_PORT=3011
TRUTHS_CHANNEL_ID=
DARES_CHANNEL_ID=

# ── project-encourage-reborn (pe) ─────────────────────
PE_DISCORD_TOKEN=
PE_CLIENT_ID=
TOPGG_URL=
TOPGG_WEBHOOK_AUTH=
# In-container listen port, read by BS app code
PE_PORT=3006
# Host-side port mapping only (root docker-compose.yml) — not read by app code
PE_SERVICE_PORT=3006

# ── Shared Discord webhooks (ms + pe) ─────────────────
DISCORD_LOG_WEBHOOK_URL=
DISCORD_ERROR_WEBHOOK_URL=

GUILD_ID=
# PE/MS internal env switch (dev/stage/prod) — separate from NODE_ENV
ENVIRONMENT=prod
