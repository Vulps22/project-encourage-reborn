# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here

# MySQL Source (migration only)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=tord

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=truth_or_dare_bot

# Logging
LOG_CHANNEL_ID=your_log_channel_id_here
DISCORD_LOG_WEBHOOK_URL=your_discord_log_webhook_url_here
DISCORD_ERROR_WEBHOOK_URL=your_discord_error_webhook_url_here

# Environment
NODE_ENV=development

# Top.gg Webhook
TOPGG_WEBHOOK_AUTH=your_topgg_webhook_auth_token
WEBHOOK_PORT=3000
