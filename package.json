{
  "name": "truth-or-dare-bot",
  "version": "1.0.0",
  "description": "A Discord bot for playing Truth or Dare with voting, XP systems, and user-submitted questions",
  "main": "dist/index.js",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "start": "node --env-file=.env dist/index.js",
    "dev": "npm run build && node --env-file=../.env.development --watch dist/index.js",
    "stage": "node --env-file=.env.staging dist/index.js",
    "prod": "node --env-file=.env.production dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.14",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.48.0"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "@vulps22/bot-interactions": "^1.0.3",
    "@vulps22/dynamic-endpoint-router": "^1.0.1",
    "@vulps22/project-encourage-types": "^1.0.0",
    "discord.js": "^14.16.3",
    "express": "^5.0.1",
    "tslib": "^2.8.1"
  }
}
